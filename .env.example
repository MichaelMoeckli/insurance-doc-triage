# Copy to .env and fill in. .env is gitignored.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional. Default: gpt-5-mini
# Any Structured-Outputs-capable model works. The client sets `reasoning.effort`
# for gpt-5-family models and `temperature: 0` for everything else.
OPENAI_MODEL=gpt-5-mini

# Optional. Default: low. One of: minimal | low | medium | high.
# Ignored for non-gpt-5 models.
OPENAI_REASONING_EFFORT=low

# Optional. Selects the prompt set from src/prompts/index.ts. Default: v1.
# This is the knob for the eval loop: run v1, read results.md, add v2, re-run.
PROMPT_VERSION=v1
