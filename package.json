{
  "name": "claim-triage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GPT-powered triage for unstructured Swiss insurance and finance documents, with a real eval harness.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "extract": "tsx src/cli/extract.ts",
    "eval": "tsx src/cli/eval.ts",
    "eval:validate": "tsx src/cli/eval.ts --validate-only",
    "eval:smoke": "tsx src/cli/eval.ts --limit 5",
    "report": "tsx src/cli/report.ts",
    "web": "next dev --webpack",
    "web:build": "next build --webpack",
    "web:start": "next start",
    "test": "node --import tsx --test src/eval/normalize.test.ts src/eval/compare.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "next": "^16.2.12",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
